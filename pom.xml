<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.cakedek</groupId>
  <artifactId>my-item-library</artifactId>
  <version>1.3</version>
  <packaging>jar</packaging>

  <name>my-item-library</name>

  <properties>
    <!--
      Bytecode level. Java 21 bytecode runs on every supported server:
      Minecraft 1.20.5 - 1.21.x (Java 21) and 26.x (Java 25).
      Building needs JDK 25 because paper-api 26.x is compiled for Java 25.
    -->
    <java.release>21</java.release>
    <!-- Compile against the newest API so removed/changed methods show up as build errors. -->
    <paper.version>[26.3.build,26.4)</paper.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>require-jdk-25</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>Build with JDK 25 or newer (paper-api 26.x is compiled for Java 25). The plugin itself still runs on Java 21 servers.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>${java.release}</release>
          <compilerArgs>
            <!-- Show deprecated/for-removal API usage so future Paper/Spigot removals are visible early. -->
            <arg>-Xlint:deprecation</arg>
            <arg>-Xlint:removal</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
  </build>

  <repositories>
      <repository>
          <id>papermc</id>
          <url>https://repo.papermc.io/repository/maven-public/</url>
      </repository>
  </repositories>

  <dependencies>
      <!--
        Paper API includes the full Bukkit/Spigot API, so the same jar runs on Spigot and Paper.
        Paper-only classes are used only in PaperChatListener, which is loaded only on Paper.
        Gson, BungeeCord chat and the MySQL/SQLite JDBC drivers are provided by the server.
      -->
      <dependency>
          <groupId>io.papermc.paper</groupId>
          <artifactId>paper-api</artifactId>
          <version>${paper.version}</version>
          <scope>provided</scope>
      </dependency>
  </dependencies>
</project>
